# ═══════════════════════════════════════════════════════════════════
#  تنظیم مدل زبانی CiaNet (لایه‌ی Provider)
#  راهنمای کامل فارسی: LLM-SETUP.md در ریشه‌ی پروژه
# ───────────────────────────────────────────────────────────────────
#  ✅ انتخاب مالک: مدل‌ها روی سرورهای Z بمانند — پس این فایل را
#  خالی/کامنت رها کنید. همین الان هم همین‌طور است: تشخیص خودکار،
#  حالت zai فعال، نشانگر سبز در تب «هوش مصنوعی» پنل.
#
#  در همین محیط سندباکس هیچ‌چیز را تغییر ندهید — مدل داخلی (Z.ai)
#  خودکار فعال است و این فایل فقط تمپلیت است.
#
#  فقط زمانی که پروژه را به سیستم خودتان منتقل کردید، یکی از
#  فرضیه‌های زیر را از کامنت دربیاورید و مقداردهی کنید.
# ───────────────────────────────────────────────────────────────────
#
# ── فرضیه ۱: سرویس ابری سازگار با OpenAI ──────────────────────────
#    (OpenRouter / Groq / DeepSeek / OpenAI / Together / xAI / …)
#
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXX
# LLM_MODEL=deepseek/deepseek-chat
# # اختیاری — مدل دیداری و مدل تصویر اگر با مدل اصلی فرق دارند:
# LLM_VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct
# LLM_IMAGE_MODEL=dall-e-3
#
# ── فرضیه ۲: کاملاً محلی و رایگان با Ollama ───────────────────────
#    (بعد از `ollama pull llama3.1:8b` — بدون هیچ کلید API)
#
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1:8b
#
# ── فرضیه ۳: سرور شخصی vLLM / llama.cpp / LM Studio ───────────────
#
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://127.0.0.1:1234/v1
# LLM_MODEL=qwen2.5-14b-instruct
#
# ── جستجوی وب روی سیستم خودتان (اختیاری) ─────────────────────────
#    ثبت‌نام رایگان در tavily.com و کپی کلید اینجا:
#
# TAVILY_API_KEY=tvly-XXXXXXXXXXXXXXXX
#
# ── نکته‌ها ─────────────────────────────────────────────────────────
#  • خواندن صفحه‌ی وب (فرمان «صفحه:») به مدل نیاز ندارد — همه‌جا کار می‌کند.
#  • بعد از تغییر این فایل، سرویس‌ها را ری‌استارت کنید
#    (mini-services/agent/agent_ctl.sh restart).
#  • اگر نمی‌خواهید کلیدتان در بکاپ گیت ذخیره شود، این فایل را در
#    مسیری خارج از پروژه بگذارید و مسیرش را با متغیر محیطی
#    LLM_ENV_FILE معرفی کنید.
#  • مهلت پاسخ‌گویی پیش‌فرض ۹۰ ثانیه است؛ با LLM_TIMEOUT_MS قابل تغییر.
# ═══════════════════════════════════════════════════════════════════
